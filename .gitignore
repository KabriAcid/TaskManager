# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*

# firebase
firebase-debug.log
firestore-debug.log

# PHP/Composer
vendor/
composer.phar
composer.lock

# PHP-specific
*.log
*.cache
*.tmp

# Storage directories (logs, uploads, cache)
/storage/logs/*
!/storage/logs/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment files (sensitive data)
.env
.env.local
.env.development
.env.production
/.env*

# OS files
Thumbs.db
.DS_Store

# Package manager locks (optional - remove if you want to track them)
package-lock.json
pnpm-lock.yaml
yarn.lock

# Build artifacts
dist/
tmp/
temp/

.exe
ngrok.exe
